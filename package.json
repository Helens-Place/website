{
  "name": "helens-place-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tina:dev": "tinacms dev -c \"astro dev\"",
    "tina:build": "tinacms build --skip-cloud-checks && astro build",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "check": "npm run check:dashes && npm run check:contrast"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "astro": "^7.2.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.6.1",
    "tinacms": "^3.12.1"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
