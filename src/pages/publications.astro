---
import { getEntry } from 'astro:content';
import ProsePage from "../components/ProsePage.astro";
import { SITE, IDS, breadcrumbs } from '../lib/schema';
import { scholarlyArticles } from '../lib/publications';

const page = await getEntry('pages', 'publications');
const THESIS_URL = 'https://purehost.bath.ac.uk/ws/portalfiles/portal/187945030/ROSS_Helen_Full_PhD_Thesis.pdf';
const works = [
  ...scholarlyArticles(page!.body ?? ''),
  ...((page!.body ?? '').includes(THESIS_URL)
    ? [{
        '@type': 'Thesis',
        name: 'Where do I fit it? Exploring how dyslexic young people experience social interactions in a mainstream secondary school',
        author: { '@id': IDS.person },
        datePublished: '2017',
        inSupportOf: 'PhD',
        sourceOrganization: { '@type': 'CollegeOrUniversity', name: 'University of Bath' },
        url: THESIS_URL,
      }]
    : []),
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: page!.data.title,
    description: page!.data.description,
    url: `${SITE}/publications`,
    about: { '@id': IDS.person },
    mainEntity: { '@type': 'ItemList', numberOfItems: works.length, itemListElement: works },
  },
  breadcrumbs([{ name: 'Publications and media', path: '/publications' }]),
];
---

<ProsePage slug="publications" schema={schema} />
