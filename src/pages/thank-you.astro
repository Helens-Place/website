---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const s = (await getEntry('settings', 'site'))!.data;
---

<BaseLayout
  title="Thank you"
  description="Your message has reached Helen's Place."
>
  <PageHero
    eyebrow="Message sent"
    heading="Thank you, your message is on its way."
    intro={`I read every enquiry myself and reply within 48 hours. If it is urgent, do ring me on ${s.phone}.`}
    primaryCta={{ label: 'Back to the homepage', href: '/' }}
  />
</BaseLayout>
