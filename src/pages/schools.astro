---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TitledList from '../components/TitledList.astro';
import CtaBand from '../components/CtaBand.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ArticleLinks from '../components/ArticleLinks.astro';
import { SITE, IDS, breadcrumbs } from '../lib/schema';

const page = await getEntry('pages', 'schools');
const p = page!.data;

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Dyslexia and SEND training for schools',
    serviceType: 'Teacher professional development',
    description: p.intro,
    provider: { '@id': IDS.business },
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    audience: { '@type': 'Audience', audienceType: 'Schools and local authorities' },
    url: `${SITE}/schools`,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Training sessions',
      itemListElement: (p.sessions ?? []).map((sv) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: sv.title, description: sv.body },
      })),
    },
  },
  breadcrumbs([{ name: 'Schools and training', path: '/schools' }]),
];
---

<BaseLayout title={p.title} description={p.description} schema={pageSchema}>
  <PageHero
    eyebrow={p.eyebrow}
    heading={p.heading}
    intro={p.intro}
    image={p.image}
    imageAlt={p.imageAlt}
    audience="schools"
    primaryCta={p.primaryCta}
  />

  {p.sessions && (
    <TitledList heading={p.sessionsHeading} items={p.sessions} background="tint" columns={3} />
  )}

  {p.also && (
    <TitledList heading={p.alsoHeading} items={p.also} columns={3} />
  )}

  {p.priceLine && (
    <section class="section section--pink">
      <div class="wrap">
        <p class="price-line">{p.priceLine}</p>
      </div>
    </section>
  )}

  {p.related && (
    <RelatedContent
      heading={p.relatedHeading!}
      intro={p.relatedIntro}
      items={p.related}
      cta={p.relatedCta}
      audience="schools"
      background="paper"
    />
  )}

  <ArticleLinks
    audience="schools"
    heading="Reading for teachers and school leaders"
    intro="Research-backed articles on inclusive teaching, wellbeing, training and technology."
    background="tint"
  />

  {p.finalCta && (
    <CtaBand heading={p.finalCta.heading} body={p.finalCta.body} cta={p.finalCta.cta} tone="purple" />
  )}
</BaseLayout>

<style>
  .price-line {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 600;
    color: var(--purple-deep);
    max-width: 46ch;
    margin: 0;
  }
</style>
