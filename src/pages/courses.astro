---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { SITE, IDS, breadcrumbs } from '../lib/schema';

const page = await getEntry('pages', 'courses');
const p = page!.data;
const c = p.featuredCourse;

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: c?.title,
    description: c?.body,
    provider: { '@id': IDS.business },
    author: { '@id': IDS.person },
    inLanguage: 'en-GB',
    url: c?.cta.href,
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: 'P4W',
    },
    offers: {
      '@type': 'Offer',
      price: '140',
      priceCurrency: 'GBP',
      category: 'Paid',
      url: c?.cta.href,
    },
  },
  breadcrumbs([{ name: 'Courses', path: '/courses' }]),
];
---

<BaseLayout title={p.title} description={p.description} schema={pageSchema}>
  <PageHero
    eyebrow={p.eyebrow}
    heading={p.heading}
    intro={p.intro}
    audience="schools"
  />

  {c && (
    <section class="section">
      <div class="wrap course">
        <div class="course__body">
          <p class="eyebrow">{c.label}</p>
          <h2>{c.title}</h2>
          <p>{c.body}</p>
          {c.bullets.length > 0 && (
            <ul class="course__bullets">
              {c.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {c.price && <p class="course__price">{c.price}</p>}
          <a href={c.cta.href} class="btn btn--primary">{c.cta.label}</a>
          {c.note && <p class="course__note">{c.note}</p>}
        </div>
        {p.image && (
          <div class="course__media">
            <Photo src={p.image} alt={p.imageAlt ?? ''} ratio="4 / 5" audience="schools" />
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .course { display: grid; grid-template-columns: 1.3fr .7fr; gap: clamp(2rem, 5vw, 3.5rem); align-items: start; }
  .course__body {
    background: var(--bg-tint);
    border-radius: var(--radius-lg);
    padding: clamp(1.8rem, 4vw, 2.8rem);
  }
  .course__bullets {
    list-style: none;
    padding: 0;
    margin: 1.4rem 0;
    display: grid;
    gap: .55rem;
  }
  .course__bullets li {
    display: flex;
    gap: .6rem;
    align-items: center;
    font-weight: 500;
    font-size: .96rem;
  }
  .course__bullets li::before {
    content: '';
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--purple);
    flex-shrink: 0;
  }
  .course__price {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--purple-deep);
    font-size: 1.15rem;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }
  .course__note { font-size: .9rem; color: var(--ink-soft); margin-top: 1.2rem; margin-bottom: 0; }
  @media (max-width: 900px) { .course { grid-template-columns: 1fr; } .course__media { max-width: 380px; } }
</style>
