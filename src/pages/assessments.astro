---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceList from '../components/ServiceList.astro';
import TitledList from '../components/TitledList.astro';
import CtaBand from '../components/CtaBand.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ArticleLinks from '../components/ArticleLinks.astro';
import { SITE, IDS, breadcrumbs } from '../lib/schema';

const page = await getEntry('pages', 'assessments');
const p = page!.data;

/* The overview is typed in Tina as paragraphs separated by a blank line. */
const overview = (p.overview ?? '').split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean);

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Diagnostic dyslexia assessment',
    serviceType: 'Dyslexia diagnostic assessment',
    description: p.description,
    provider: { '@id': IDS.business },
    areaServed: [
      { '@type': 'City', name: 'Trowbridge' },
      { '@type': 'AdministrativeArea', name: 'Wiltshire' },
      { '@type': 'Country', name: 'United Kingdom' },
    ],
    audience: { '@type': 'Audience', audienceType: 'Parents and families' },
    url: `${SITE}/assessments`,
    offers: (p.services ?? []).map((sv) => ({
      '@type': 'Offer',
      name: sv.name,
      priceCurrency: 'GBP',
      description: `${sv.name}, ${sv.price}`,
    })),
  },
  breadcrumbs([{ name: 'Assessments', path: '/assessments' }]),
];
---

<BaseLayout title={p.title} description={p.description} schema={pageSchema}>
  <PageHero
    eyebrow={p.eyebrow}
    heading={p.heading}
    intro={p.intro}
    image={p.image}
    imageAlt={p.imageAlt}
    audience="families"
    primaryCta={p.primaryCta}
  />

  {p.overview && (
    <section class="section">
      <div class="wrap">
        {p.overviewHeading && <h2>{p.overviewHeading}</h2>}
        {overview.map((para) => <p>{para}</p>)}
        {p.trustLine && <p class="trust">{p.trustLine}</p>}
      </div>
    </section>
  )}

  {p.services && (
    <ServiceList heading={p.servicesHeading!} note={p.servicesNote} items={p.services} />
  )}

  {p.whyBody && (
    <section class="section">
      <div class="wrap">
        <h2>{p.whyHeading}</h2>
        <p>{p.whyBody}</p>
      </div>
    </section>
  )}

  {p.steps && (
    <TitledList heading={p.stepsHeading} items={p.steps} variant="steps" background="tint" />
  )}

  {p.related && (
    <RelatedContent
      heading={p.relatedHeading!}
      intro={p.relatedIntro}
      items={p.related}
      cta={p.relatedCta}
      audience="families"
      background="paper"
    />
  )}

  <ArticleLinks
    audience="families"
    heading="Reading on dyslexia, assessment and family life"
    intro="Longer pieces, each grounded in research I have published, with the sources linked."
    background="tint"
  />

  {p.finalCta && (
    <CtaBand heading={p.finalCta.heading} body={p.finalCta.body} cta={p.finalCta.cta} />
  )}
</BaseLayout>

<style>
  .trust {
    font-weight: 500;
    background: var(--bg-tint);
    border-radius: var(--radius);
    padding: .8rem 1.1rem;
    margin: .6rem 0 0;
  }
</style>
