---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceList from '../components/ServiceList.astro';
import TitledList from '../components/TitledList.astro';
import CtaBand from '../components/CtaBand.astro';
import RelatedContent from '../components/RelatedContent.astro';
import Photo from '../components/Photo.astro';
import { SITE, IDS, breadcrumbs } from '../lib/schema';

const page = await getEntry('pages', 'assessments');
const p = page!.data;

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Diagnostic dyslexia assessment',
    serviceType: 'Dyslexia diagnostic assessment',
    description: p.intro,
    provider: { '@id': IDS.business },
    areaServed: [
      { '@type': 'City', name: 'Trowbridge' },
      { '@type': 'AdministrativeArea', name: 'Wiltshire' },
      { '@type': 'Country', name: 'United Kingdom' },
    ],
    audience: { '@type': 'Audience', audienceType: 'Parents and families' },
    url: `${SITE}/assessments`,
    offers: (p.services ?? []).map((sv) => ({
      '@type': 'Offer',
      name: sv.name,
      priceCurrency: 'GBP',
      description: `${sv.name}, ${sv.price}`,
    })),
  },
  breadcrumbs([{ name: 'Assessments', path: '/assessments' }]),
];
---

<BaseLayout title={p.title} description={p.description} schema={pageSchema}>
  <PageHero
    eyebrow={p.eyebrow}
    heading={p.heading}
    intro={p.intro}
    trustLine={p.trustLine}
    audience="families"
    primaryCta={p.primaryCta}
  />

  {p.services && (
    <ServiceList heading={p.servicesHeading!} note={p.servicesNote} items={p.services} />
  )}

  {p.whyBody && (
    <section class="section">
      <div class="wrap why">
        <div>
          <h2>{p.whyHeading}</h2>
          <p>{p.whyBody}</p>
        </div>
        {p.image && (
          <Photo src={p.image} alt={p.imageAlt ?? ''} ratio="3 / 2" audience="families" />
        )}
      </div>
    </section>
  )}

  {p.steps && (
    <TitledList heading={p.stepsHeading} items={p.steps} variant="steps" background="tint" />
  )}

  {p.related && (
    <RelatedContent
      heading={p.relatedHeading!}
      intro={p.relatedIntro}
      items={p.related}
      cta={p.relatedCta}
      audience="families"
      background="paper"
    />
  )}

  {p.finalCta && (
    <CtaBand heading={p.finalCta.heading} body={p.finalCta.body} cta={p.finalCta.cta} />
  )}
</BaseLayout>

<style>
  .why { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
  @media (max-width: 850px) { .why { grid-template-columns: 1fr; } }
</style>
