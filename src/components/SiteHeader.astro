---
import fs from 'node:fs';
import path from 'node:path';
import { getEntry } from 'astro:content';

const site = await getEntry('settings', 'site');
const s = site!.data;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const hasLogo = fs.existsSync(path.join(process.cwd(), 'public', 'images', 'logo.png'));
---

<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="brand" aria-label={`${s.siteName}, home`}>
      {hasLogo
        ? <img src="/images/logo.png" alt={s.siteName} class="brand__logo" width="200" height="110" />
        : <span class="brand__text">Helen's<span>Place</span></span>}
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav__list">
        {s.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav__link"
              aria-current={current === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
      <a href={s.bookCallHref} class="btn btn--primary nav__cta">{s.bookCallLabel}</a>
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
  }
    /* The nav carries the brief's full labels, e.g. "Research and expert
     witness", which do not fit the 1140px text measure. The header alone gets
     a wider container. */
  .header__inner {
    width: min(1320px, 100% - 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: .85rem;
  }
  .brand { display: inline-flex; align-items: center; text-decoration: none; flex-shrink: 0; }
  .brand__logo { height: 54px; width: auto; }
  .brand__text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--purple);
    display: flex;
    flex-direction: column;
  }
  .brand__text span { padding-left: 1.1em; }

  .nav { display: flex; align-items: center; gap: 1.35rem; }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__list li { max-width: none; }
  .nav__link {
    font-size: .92rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding-block: .35rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .nav__link:hover { color: var(--purple-deep); border-bottom-color: var(--purple); }
  .nav__link[aria-current='page'] { color: var(--purple-deep); border-bottom-color: var(--purple); font-weight: 600; }
  .nav__cta { padding: .6rem 1.2rem; font-size: .92rem; }

  .nav-toggle {
    display: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    width: 46px;
    height: 46px;
    cursor: pointer;
    place-items: center;
  }
  .nav-toggle__bars,
  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    position: relative;
  }
  .nav-toggle__bars::before,
  .nav-toggle__bars::after { content: ''; position: absolute; }
  .nav-toggle__bars::before { top: -6px; }
  .nav-toggle__bars::after { top: 6px; }

  @media (max-width: 1200px) {
    .nav-toggle { display: grid; }
    .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 1rem 1.25rem 1.5rem;
      display: none;
      box-shadow: var(--shadow);
    }
    .nav[data-open='true'] { display: flex; }
    .nav__list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav__link {
      display: block;
      padding: .8rem 0;
      border-bottom: 1px solid var(--line);
      white-space: normal;
    }
    .nav__link:hover, .nav__link[aria-current='page'] { border-bottom-color: var(--line); }
    .nav__cta { margin-top: 1.1rem; justify-content: center; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.setAttribute('data-open', String(open));
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  /* Escape closes the menu and puts focus back on the button, so a keyboard
     user is never stranded inside an open menu. */
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  /* Clicking a link closes the menu rather than leaving it hanging open. */
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
