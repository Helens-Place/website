---
/**
 * Netlify Forms. The static HTML is detected at deploy time, so submissions
 * arrive in the Netlify dashboard with no backend to maintain.
 *
 * Accessibility notes:
 * - The honeypot is hidden from assistive technology as well as from sight.
 *   A screen reader user who filled it in would have their enquiry silently
 *   binned as spam, which is exactly the person this practice exists to serve.
 * - Hints are wired with aria-describedby rather than sitting inside the label,
 *   so they are read as descriptions and do not bloat each field's name.
 * - Required fields rely on the native `required` attribute, which assistive
 *   technology announces. The asterisk is decorative and hidden from it.
 */
---

<form
  name="contact"
  method="POST"
  action="/thank-you"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="form"
>
  <input type="hidden" name="form-name" value="contact" />

  <p class="form__hp" aria-hidden="true">
    <label for="bot-field">Leave this field empty if you are human:</label>
    <input id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
  </p>

  <div class="form__row">
    <div class="field">
      <label class="field__label" for="name">
        Your name <abbr title="required" aria-hidden="true">*</abbr>
      </label>
      <input type="text" id="name" name="name" required autocomplete="name" />
    </div>
    <div class="field">
      <label class="field__label" for="email">
        Email address <abbr title="required" aria-hidden="true">*</abbr>
      </label>
      <input type="email" id="email" name="email" required autocomplete="email" />
    </div>
  </div>

  <div class="form__row">
    <div class="field">
      <label class="field__label" for="phone">Phone number</label>
      <p class="field__hint" id="phone-hint">Optional, if you would rather I rang you.</p>
      <input type="tel" id="phone" name="phone" autocomplete="tel" aria-describedby="phone-hint" />
    </div>
    <div class="field">
      <label class="field__label" for="organisation">School or organisation</label>
      <p class="field__hint" id="org-hint">Optional.</p>
      <input type="text" id="organisation" name="organisation" autocomplete="organization" aria-describedby="org-hint" />
    </div>
  </div>

  <div class="field">
    <label class="field__label" for="enquiry">
      How can I help? <abbr title="required" aria-hidden="true">*</abbr>
    </label>
    <select id="enquiry" name="enquiry" required>
      <option value="">Please choose one</option>
      <option>Dyslexia assessment for my child</option>
      <option>Dyslexia assessment for myself</option>
      <option>Exam access arrangements</option>
      <option>Specialist tutoring, maths or literacy</option>
      <option>Family support and advice</option>
      <option>School training, INSET or CPD</option>
      <option>SEND consultancy</option>
      <option>Research or consultancy project</option>
      <option>Expert witness instruction</option>
      <option>Speaking engagement</option>
      <option>Something else</option>
    </select>
  </div>

  <div class="field">
    <label class="field__label" for="message">
      Tell me a little more <abbr title="required" aria-hidden="true">*</abbr>
    </label>
    <p class="field__hint" id="message-hint">
      A sentence or two is plenty. There is no wrong way to write this.
    </p>
    <textarea id="message" name="message" rows="6" required aria-describedby="message-hint"></textarea>
  </div>

  <button type="submit" class="btn btn--primary">Send message</button>
  <p class="form__note">I reply within 48 hours.</p>
</form>

<style>
  .form { max-width: 44rem; }
  .form__hp { position: absolute; left: -9999px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .field { margin-bottom: 1.3rem; }
  .field__label { display: block; font-weight: 600; font-size: .95rem; margin-bottom: .35rem; }
  .field__hint { font-size: .85rem; color: var(--ink-soft); margin: 0 0 .45rem; max-width: 46ch; }
  .field abbr { color: var(--pink-accent); text-decoration: none; }

  input, select, textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: var(--radius);
    padding: .75rem .9rem;
    line-height: 1.5;
  }
  input:hover, select:hover, textarea:hover { border-color: var(--purple); }
  textarea { resize: vertical; }
  .form__note { font-size: .9rem; color: var(--ink-soft); margin: 1rem 0 0; }

  @media (max-width: 640px) { .form__row { grid-template-columns: 1fr; gap: 0; } }
</style>
