---
/**
 * Analytics, off by default.
 *
 * Nothing is emitted until a provider and token are set in site settings, so
 * the site ships with no third-party script and no tracking at all.
 *
 * Two providers are supported, both chosen because they produce aggregate
 * statistics only:
 *
 *   cloudflare  free, sets no cookies and writes nothing to browser storage
 *   plausible   paid, EU hosted, also cookieless
 *
 * Why not Google Analytics: it sets cookies and processes visitor-level data
 * for purposes beyond improving this website, so under PECR it needs consent.
 * That means a banner in front of every visitor, on a site whose whole point is
 * being easy to use. See the note in README.
 */
import { getEntry } from 'astro:content';

const site = await getEntry('settings', 'site');
const provider = site!.data.analyticsProvider ?? 'none';
const token = site!.data.analyticsToken ?? '';
const enabled = provider !== 'none' && token.trim().length > 0;
---

{/*
  Cloudflare Web Analytics, plus the site's own count of page reads by town
  (worker/hits.js), because Web Analytics only goes down to country. The ping
  sends the page's path and nothing else; the Worker adds Cloudflare's estimate
  of the town.

  Neither runs in a browser that has opened the TinaCMS editor
  (tina/dont-count-me.ts), so Helen checking her own edits is not counted as a
  visitor. Both are loaded from this script rather than a plain tag so that
  check can come first.
*/}
{enabled && provider === 'cloudflare' && (
  <script is:inline define:vars={{ token }}>
    var mine = false;
    try {
      mine = localStorage.getItem('hp-dont-count') === '1';
    } catch (e) {
      /* Storage refused, as in some private windows: count the visit. */
    }
    if (!mine) {
      var s = document.createElement('script');
      s.defer = true;
      s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      s.setAttribute('data-cf-beacon', JSON.stringify({ token: token }));
      document.head.appendChild(s);
      try {
        navigator.sendBeacon('/api/hit', location.pathname);
      } catch (e) {
        /* Not counted, which is fine. */
      }
    }
  </script>
)}

{enabled && provider === 'plausible' && (
  <script defer data-domain={token} src="https://plausible.io/js/script.js" />
)}
