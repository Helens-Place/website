---
interface Door {
  audience: 'families' | 'schools' | 'business';
  label: string;
  title: string;
  body: string;
  price?: string;
  linkLabel: string;
  href: string;
}
interface Props { heading: string; subheading?: string; doors: Door[] }
const { heading, subheading, doors } = Astro.props;
---

<section class="section doors" id="doors">
  <div class="wrap">
    <div class="section-head">
      <h2>{heading}</h2>
      {subheading && <p class="lede">{subheading}</p>}
    </div>
    <ul class="doors__grid">
      {doors.map((d) => (
        <li class="door" data-audience={d.audience}>
          <p class="door__label">{d.label}</p>
          <h3 class="door__title">{d.title}</h3>
          <p class="door__body">{d.body}</p>
          {d.price && <p class="door__price">{d.price}</p>}
          <a href={d.href} class="door__link">
            {d.linkLabel}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .doors__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .door {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    padding: 2.1rem 1.9rem;
    max-width: none;
    border: 1px solid transparent;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .door:hover { transform: translateY(-4px); box-shadow: var(--shadow); }

  .door[data-audience='families'] { background: var(--pink-soft); }
  .door[data-audience='families'] .door__label,
  .door[data-audience='families'] .door__link { color: var(--pink-accent); }

  .door[data-audience='schools'] { background: var(--bg-tint); }
  .door[data-audience='schools'] .door__label,
  .door[data-audience='schools'] .door__link { color: var(--purple); }

  .door[data-audience='business'] { background: var(--business-fill); }
  .door[data-audience='business'] .door__label,
  .door[data-audience='business'] .door__link { color: var(--purple-deep); }

  .door__label {
    font-size: .85rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: .7rem;
    max-width: none;
  }
  .door__title { font-size: 1.3rem; margin-bottom: .7rem; }
  .door__body { font-size: 1rem; color: var(--ink); margin-bottom: 1.1rem; }
  .door__price {
    font-weight: 600;
    font-size: .97rem;
    color: var(--ink);
    border-top: 1px solid rgba(42, 27, 61, .14);
    padding-top: .9rem;
    margin-bottom: 1.1rem;
  }
  .door__link {
    margin-top: auto;
    font-weight: 700;
    font-size: .95rem;
    text-decoration: none;
    display: inline-flex;
    gap: .4rem;
    align-items: center;
  }
  .door__link:hover { text-decoration: underline; }
  .door:hover .door__link span { transform: translateX(3px); }
  .door__link span { transition: transform .2s ease; }

  @media (max-width: 950px) { .doors__grid { grid-template-columns: 1fr; } }
</style>
