---
/**
 * Renders a photograph from /public/images.
 * If the file is not present yet, it renders a labelled placeholder block in
 * the brand colours instead, so the build never breaks and real photos drop
 * straight in later without touching any markup.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;
  alt: string;
  ratio?: string;
  audience?: 'families' | 'schools' | 'business' | 'neutral';
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  ratio = '4 / 5',
  audience = 'neutral',
  loading = 'lazy',
  class: className = '',
} = Astro.props;

/* Accept any of the forms this value turns up in.

   Content files written by hand use a bare filename. TinaCMS rewrites the
   field on every save, and has produced two different broken shapes so far:

     /imageshelen-hero.jpg                            separator dropped
     /images/__staging/content/__filehelen-hero.jpg   staging prefix, on a branch

   Both appeared when the editor had only changed text elsewhere on the page,
   because saving re-serialises every field rather than just the edited one.
   So this is not a one off and cannot be left to chance.

   Every image lives flat in public/images, so whatever arrives is reduced to
   its filename. The alternative is a hero image that silently disappears. */
const file = src
  .replace(/^\/?images\/?/, '')          // rooted path, separator optional
  .replace(/^__staging\/.*?__file/, '')  // TinaCloud media staging prefix
  .replace(/^.*\//, '');                 // any directories left over
const exists = fs.existsSync(path.join(process.cwd(), 'public', 'images', file));
const fills: Record<string, string> = {
  families: 'var(--pink-soft)',
  schools: 'var(--bg-tint)',
  business: 'var(--business-fill)',
  neutral: 'var(--bg-tint)',
};
---

{exists ? (
  <img
    class={`photo ${className}`}
    src={`/images/${file}`}
    alt={alt}
    loading={loading}
    decoding="async"
    style={`aspect-ratio:${ratio}`}
  />
) : (
  <div
    class={`photo photo--placeholder ${className}`}
    style={`aspect-ratio:${ratio}; background:${fills[audience]}`}
    role="img"
    aria-label={alt}
  >
    <span class="photo__label">
      <strong>Photo to come</strong>
      <span>{file}</span>
    </span>
  </div>
)}

<style>
  .photo {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }
  .photo--placeholder {
    display: grid;
    place-items: center;
    border: 2px dashed var(--line);
    text-align: center;
    padding: 1.5rem;
  }
  .photo__label {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    color: var(--ink-soft);
    font-size: .85rem;
  }
  .photo__label strong {
    font-family: var(--font-display);
    color: var(--purple-deep);
    font-size: 1rem;
  }
  .photo__label span { font-family: ui-monospace, 'Cascadia Code', monospace; }
</style>
