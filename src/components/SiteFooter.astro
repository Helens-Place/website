---
import { getEntry } from 'astro:content';
const site = await getEntry('settings', 'site');
const s = site!.data;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <p class="footer__strapline">{s.strapline}</p>
      <p class="footer__note">{s.footerNote}</p>
      <ul class="footer__socials">
        {s.socials.map((l) => (
          <li><a href={l.href} rel="me noopener">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__cols">
      <div>
        <h2 class="footer__heading">Services</h2>
        <ul class="footer__list">
          <li><a href="/assessments">Dyslexia assessments</a></li>
          <li><a href="/what-to-expect">What to expect</a></li>
          <li><a href="/elevator-series">The Elevator Series</a></li>
          <li><a href="/schools">Schools and training</a></li>
          <li><a href="/research-and-expert-witness">Research and expert witness</a></li>
          <li><a href="/courses">Courses and guides</a></li>
          <li><a href="/dyslexia-toolkit">Schools Guide to Dyslexia</a></li>
          <li><a href="/speaking">Speaking</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__heading">Helen's Place</h2>
        <ul class="footer__list">
          <li><a href="/about">About Helen</a></li>
          <li><a href="/churchill-fellowship">Churchill Fellowship</a></li>
          <li><a href="/book">The book</a></li>
          <li><a href="/faq">Questions and answers</a></li>
          <li><a href="/publications">Publications</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__heading">Get in touch</h2>
        <ul class="footer__list">
          <li><a href={`mailto:${s.email}`}>{s.email}</a></li>
          {s.mobile && (
            <li><a href={`tel:${s.mobile.replace(/\s/g, '')}`}>{s.mobile}</a></li>
          )}
          <li>{s.location}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="wrap footer__bar">
    <p>© {year} Helen's Place · Dr Helen Ross · Trowbridge, Wiltshire</p>
    <ul class="footer__legal">
      {s.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-tint);
    border-top: 1px solid var(--line);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    margin-top: auto;
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.1fr 2fr;
    gap: 3.5rem;
    padding-bottom: 2.5rem;
  }
  .footer__strapline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--purple-deep);
    margin-bottom: .8rem;
  }
  .footer__note { font-size: .97rem; color: var(--ink-soft); }
  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem .9rem;
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
  }
  .footer__socials li { max-width: none; }
  .footer__socials a { font-size: .9rem; font-weight: 600; }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .footer__heading {
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .09em;
    color: var(--purple-deep);
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-weight: 700;
  }
  .footer__list { list-style: none; padding: 0; margin: 0; }
  .footer__list li { margin-bottom: .55rem; font-size: .97rem; color: var(--ink-soft); max-width: none; }
  .footer__list a { color: var(--ink-soft); text-decoration: none; }
  .footer__list a:hover { color: var(--purple-deep); text-decoration: underline; }

  .footer__bar {
    border-top: 1px solid var(--muted);
    padding-block: 1.4rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer__bar p { font-size: .85rem; color: var(--ink-soft); margin: 0; max-width: none; }
  .footer__legal { display: flex; gap: 1.1rem; list-style: none; margin: 0; padding: 0; }
  .footer__legal li { max-width: none; }
  .footer__legal a { font-size: .85rem; color: var(--ink-soft); }

  @media (max-width: 900px) {
    .footer__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .footer__cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer__cols { grid-template-columns: 1fr; }
  }
</style>
