---
import Photo from './Photo.astro';
interface Props {
  heading: string;
  body: string;
  cta: { label: string; href: string };
  image?: string;
  imageAlt?: string;
}
const { heading, body, cta, image, imageAlt } = Astro.props;
---
<section class="section section--tint">
  <div class="wrap book-band">
    {image && (
      <div class="book-band__cover">
        <Photo src={image} alt={imageAlt ?? ''} ratio="2 / 3" audience="schools" />
      </div>
    )}
    <div class="book-band__text">
      <p class="eyebrow">The book</p>
      <h2>{heading}</h2>
      <p>{body}</p>
      <a href={cta.href} class="btn btn--primary">{cta.label}</a>
    </div>
  </div>
</section>

<style>
  .book-band {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  .book-band__cover :global(.photo) { box-shadow: var(--shadow); border-radius: var(--radius); }
  .book-band__text .btn { margin-top: .8rem; }
  @media (max-width: 800px) {
    .book-band { grid-template-columns: 1fr; }
    .book-band__cover { max-width: 220px; }
  }
</style>
