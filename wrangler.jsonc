// Cloudflare Workers configuration for helensplace.co.uk.
//
// How changes go live. Everything happens on the main branch: a push to main,
// including every save in TinaCMS, runs `npm run tina:build` and then
// `npx wrangler deploy`, which publishes it. A save is live in about three
// minutes, the time the build takes. To undo a bad change, Deployments >
// Rollback in the Worker restores an earlier version.
//
// The site is static: the build writes it to dist/. The small script in worker/
// only handles the contact form.
//
// Plain settings live here rather than in the dashboard, because a deploy
// replaces dashboard variables with these. Secrets (RESEND_API_KEY,
// TURNSTILE_SECRET_KEY, CF_ANALYTICS_TOKEN) are set in the dashboard under
// Variables and secrets.
// Build variables (TINA_CLIENT_ID, TINA_TOKEN, NODE_VERSION,
// PUBLIC_TURNSTILE_SITE_KEY) are set under Settings > Build, and are not
// available at runtime.
{
  "name": "website",
  "compatibility_date": "2026-10-11",
  "main": "./worker/index.js",
  "workers_dev": true,
  // No per-version links: every change is published as soon as it is built.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // about.html is served at /about, matching the site's canonical URLs.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_FROM": "Helen's Place website <enquiries@helensplace.co.uk>",
    "CONTACT_TO": "helen@helensplace.co.uk",
    // For the Analytics screen (worker/analytics.js). None of these is secret:
    // the client id is in the admin's own code, and the account and site tags
    // are useless without CF_ANALYTICS_TOKEN, which is a dashboard secret.
    "TINA_CLIENT_ID": "69261f1d-ef54-4694-beb5-5b5238b23663",
    "CF_ACCOUNT_ID": "0842f4617e488b5b222262eee443b8e4",
    "CF_SITE_TAG": "aed3229d66ae4a1680c63c8fd185f913",
    // The helensplace.co.uk zone, for the AI crawler panel.
    "CF_ZONE_ID": "04f253d8d98928641fba51baa0607447"
  },
  // Page reads by town, for the Analytics screen (worker/hits.js). Analytics
  // Engine had to be switched on in the account first (done 11 October 2026);
  // the dataset is created on the first write and keeps rows for three months.
  // Without this line the ping is accepted and dropped, and the Towns panel
  // says it is not switched on.
  "analytics_engine_datasets": [{ "binding": "HITS", "dataset": "helensplace_hits" }],
  "observability": { "enabled": true }
}
