// Cloudflare Workers configuration for helensplace.co.uk.
//
// The site is static: `npm run tina:build` writes it to dist/, and Workers
// Builds then runs `npx wrangler deploy` (the main branch) or
// `npx wrangler preview` (any other branch). The small script in worker/ only
// handles the contact form.
//
// Plain settings live here rather than in the dashboard, because a deploy
// replaces dashboard variables with these. Secrets (RESEND_API_KEY,
// TURNSTILE_SECRET_KEY) are set in the dashboard, once for Production and once
// for Previews Base, since Previews do not inherit production settings. Build
// variables (TINA_CLIENT_ID, TINA_TOKEN, NODE_VERSION, PUBLIC_TURNSTILE_SITE_KEY)
// are set under Settings > Build, and are not available at runtime.
{
  "name": "website",
  "compatibility_date": "2026-10-11",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // about.html is served at /about, matching the site's canonical URLs.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_FROM": "Helen's Place website <enquiries@helensplace.co.uk>",
    "CONTACT_TO": "helen@helensplace.co.uk"
  },
  "previews": {
    "vars": {
      "CONTACT_FROM": "Helen's Place website <enquiries@helensplace.co.uk>",
      "CONTACT_TO": "helen@helensplace.co.uk"
    }
  },
  "observability": { "enabled": true }
}
